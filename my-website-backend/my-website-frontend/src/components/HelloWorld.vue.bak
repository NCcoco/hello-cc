<template>
  <div class="hello">
    <h1>{{ msg }}</h1>
    <p>{{ backendMessage }}</p>
  </div>
</template>

<script>
import axios from 'axios';

export default {
  name: 'HelloWorld',
  props: {
    msg: String
  },
  data() {
    return {
      backendMessage: 'Loading message from backend...'
    };
  },
  mounted() {
    // Assuming the Spring Boot backend is running on port 8080
    // And Vue dev server is on a different port (e.g., 8081)
    // We need to configure proxy for /api calls or use full URL.
    // For now, using full URL. This will require CORS configuration on Spring Boot side.
    axios.get('http://localhost:8080/api/hello')
      .then(response => {
        this.backendMessage = response.data;
      })
      .catch(error => {
        this.backendMessage = 'Failed to load message from backend: ' + error.message;
        console.error("Error fetching data: ", error);
      });
  }
}
</script>

<style scoped>
h3 {
  margin: 40px 0 0;
}
ul {
  list-style-type: none;
  padding: 0;
}
li {
  display: inline-block;
  margin: 0 10px;
}
a {
  color: #42b983;
}
</style>
