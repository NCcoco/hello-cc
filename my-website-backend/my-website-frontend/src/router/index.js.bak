import { createRouter, createWebHistory } from 'vue-router';
import HelloWorld from '../components/HelloWorld.vue'; // General placeholder

const routes = [
  {
    path: '/',
    name: 'Home',
    component: HelloWorld,
    props: { msg: 'Welcome to Your Personal Site' }
  },
  {
    path: '/english', // New route for English
    name: 'English',
    component: HelloWorld, // Placeholder, will be updated
    props: { msg: 'English Learning Section' }
  },
  {
    path: '/java',
    name: 'Java',
    component: HelloWorld,
    props: { msg: 'Java Content Page' }
  },
  {
    path: '/ai',
    name: 'AI',
    component: HelloWorld,
    props: { msg: 'Artificial Intelligence Content Page' }
  },
  {
    path: '/math',
    name: 'Math',
    component: HelloWorld,
    props: { msg: 'Mathematics Content Page' }
  },
  {
    path: '/dev',
    name: 'DevInProgress',
    component: HelloWorld,
    props: { msg: 'Content Under Development' }
  }
];

const router = createRouter({
  history: createWebHistory(process.env.BASE_URL),
  routes
});

export default router;
